{
  "name": "meadow",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch server/cli.ts start --dev",
    "meadow": "tsx server/cli.ts",
    "build": "vite build && esbuild server/cli.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/meadow.js --loader:.md=text && esbuild server/bin.ts --platform=node --format=esm --target=node14 --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" && esbuild server/relay/main.ts --platform=node --bundle --format=esm --outfile=dist/relay.js && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "start": "node dist/cli.js start",
    "relay": "node dist/relay.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@trpc/server": "^11.6.0",
    "cross-spawn": "^7.0.6",
    "express": "^4.21.2",
    "superjson": "^1.13.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/vite": "^4.1.3",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.12.0",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "esbuild": "^0.25.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.453.0",
    "motion": "^13.5.0",
    "next-themes": "^0.4.6",
    "pnpm": "10.18.0",
    "prettier": "^3.6.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.1.7",
    "vitest": "^2.1.4",
    "wouter": "^3.3.5"
  },
  "packageManager": "pnpm@10.18.0",
  "description": "Local-first agent that turns a request into finished, tested code by driving a coding engine phase by phase.",
  "bin": {
    "meadow": "dist/cli.js"
  },
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "docs/EDGE-CASES.md"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}
