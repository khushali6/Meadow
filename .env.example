# ── Meadow Environment Configuration ──────────────────────────────────────────
# Copy this file to ~/.meadow/secrets.env (mode 600) or export vars directly.
# Never commit real values to source control.
#
#   cp .env.example ~/.meadow/secrets.env
#   chmod 600 ~/.meadow/secrets.env
#
# ── Coding Engine ─────────────────────────────────────────────────────────────

# Cursor CLI (recommended) — obtain from https://cursor.com/settings
CURSOR_API_KEY=

# Anthropic Claude Code — obtain from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI Codex — obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — obtain from https://aistudio.google.com/
GOOGLE_AI_API_KEY=

# ── Agent / Planner Model ─────────────────────────────────────────────────────
# The LLM Meadow uses for planning, summaries, Q&A, and CodeAtlas.
# Defaults to FreeLLMAPI (free tier). Set one of the above keys for a better model.

# FreeLLMAPI (free, no key needed for basic use) — https://freellmapi.com/
# FREELLMAPI_API_KEY=

# Custom OpenAI-compatible endpoint (Ollama, LM Studio, OpenRouter, etc.)
# MEADOW_LLM_PROVIDER=custom
# MEADOW_LLM_BASE_URL=http://localhost:11434/v1
# MEADOW_LLM_MODEL=qwen2.5-coder:32b
# MEADOW_LLM_EMBEDDING_MODEL=nomic-embed-text

# ── GitHub Integration ────────────────────────────────────────────────────────
# Personal Access Token (PAT) with `repo` scope for auto-creating private repos
# and pushing passed phases. Generate at https://github.com/settings/tokens
GITHUB_TOKEN=

# ── Telegram Remote Control ───────────────────────────────────────────────────
# Create a bot at https://t.me/BotFather, get the token and your chat/user ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# ── Supabase (optional) ───────────────────────────────────────────────────────
# Required only for projects that use Supabase as a service.
SUPABASE_ACCESS_TOKEN=

# ── Atlas Connectors (optional) ───────────────────────────────────────────────
# Jira — for indexing issues/incidents into CodeAtlas
JIRA_API_TOKEN=
# Linear
LINEAR_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
# Defaults: host=127.0.0.1, port=56000
# MEADOW_HOST=0.0.0.0      # bind to all interfaces (for Docker / remote access)
# MEADOW_PORT=56000

# ── Projects Directory ────────────────────────────────────────────────────────
# Where Meadow creates new project folders. Defaults to ~/meadow-projects.
# MEADOW_PROJECTS_DIR=/home/user/projects

# ── Safety Limits ────────────────────────────────────────────────────────────
# Token budget per phase and per day (prevents runaway costs).
# MEADOW_BUDGET_PHASE_TOKENS=200000
# MEADOW_BUDGET_DAILY_TOKENS=2000000
# MEADOW_BUDGET_PHASE_WALL_CLOCK_S=3600

# ── Engine Timeouts ───────────────────────────────────────────────────────────
# MEADOW_ENGINE_RUN_TIMEOUT_S=1800
# MEADOW_ENGINE_NO_OUTPUT_TIMEOUT_S=300

# ── Development ───────────────────────────────────────────────────────────────
# Set to 1 to enable verbose logging
# MEADOW_DEBUG=1
